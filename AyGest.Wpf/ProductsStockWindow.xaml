<Window x:Class="AyGest.Wpf.ProductsStockWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Produtos e Stock — AyGest" Width="1500" Height="920" Background="#F5F7FA" WindowStartupLocation="CenterOwner"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><StackPanel><TextBlock Text="Produtos e Stock" FontSize="30" FontWeight="Bold" Foreground="#14213D"/><TextBlock Text="Catálogo, preços, inventário, movimentos, alertas e controlo de stock" Foreground="#64748B" Margin="0,4,0,18"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Entrada" Click="Entry_Click" Width="95" Height="40"/><Button Content="Saída" Click="Exit_Click" Width="95" Height="40"/><Button Content="Ajuste" Click="Adjust_Click" Width="95" Height="40"/><Button Content="Exportar" Click="Export_Click" Width="100" Height="40"/><Button Content="＋ Novo produto" Click="New_Click" Width="150" Height="40"/></StackPanel></DockPanel><Grid Grid.Row="1" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" Grid.Column="0" Height="40" VerticalContentAlignment="Center" TextChanged="FilterChanged"/><ComboBox x:Name="CategoryBox" Grid.Column="1" Margin="8,0,0,0" Height="40" SelectionChanged="FilterChanged"><ComboBoxItem Content="Todas categorias" IsSelected="True"/></ComboBox><ComboBox x:Name="StockBox" Grid.Column="2" Margin="8,0,0,0" Height="40" SelectionChanged="FilterChanged"><ComboBoxItem Content="Todo stock" IsSelected="True"/><ComboBoxItem Content="Stock baixo"/><ComboBoxItem Content="Sem stock"/></ComboBox><ComboBox x:Name="StatusBox" Grid.Column="3" Margin="8,0,0,0" Height="40" SelectionChanged="FilterChanged"><ComboBoxItem Content="Todos estados" IsSelected="True"/><ComboBoxItem Content="Activos"/><ComboBoxItem Content="Inactivos"/></ComboBox><Button Grid.Column="4" Margin="8,0,0,0" Content="Actualizar" Click="Refresh_Click"/></Grid><Border Grid.Row="2" Background="White" CornerRadius="14" Padding="12"><DataGrid x:Name="ProductsGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="None" RowHeight="62"><DataGrid.Columns><DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="110"/><DataGridTextColumn Header="Produto" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Categoria" Binding="{Binding Category}" Width="140"/><DataGridTextColumn Header="Preço venda" Binding="{Binding SalePrice}" Width="125"/><DataGridTextColumn Header="Custo" Binding="{Binding CostPrice}" Width="115"/><DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="95"/><DataGridTextColumn Header="Mínimo" Binding="{Binding MinStock}" Width="95"/><DataGridTextColumn Header="Unidade" Binding="{Binding Unit}" Width="90"/><DataGridTextColumn Header="IVA" Binding="{Binding Vat}" Width="75"/><DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="90"/><DataGridTemplateColumn Header="Acções" Width="245"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="Editar" Click="Edit_Click" Tag="{Binding}"/><Button Content="Stock" Click="Stock_Click" Tag="{Binding}"/><Button Content="Histórico" Click="History_Click" Tag="{Binding}"/><Button Content="⋯" Click="More_Click" Tag="{Binding}"/></StackPanel></DataTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Border><StatusBar Grid.Row="3" Margin="0,12,0,0"><StatusBarItem Content="Produtos:"/><StatusBarItem x:Name="CountText"/><Separator/><StatusBarItem Content="Unidades em stock:"/><StatusBarItem x:Name="UnitsText"/><Separator/><StatusBarItem Content="Valor de stock:"/><StatusBarItem x:Name="ValueText"/><Separator/><StatusBarItem Content="Stock baixo:"/><StatusBarItem x:Name="LowText"/></StatusBar></Grid></Window>