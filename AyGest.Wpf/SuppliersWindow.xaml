<Window x:Class="AyGest.Wpf.SuppliersWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Fornecedores — AyGest" Width="1400" Height="850" Background="#F5F7FA" WindowStartupLocation="CenterOwner"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><StackPanel><TextBlock Text="Fornecedores" FontSize="30" FontWeight="Bold" Foreground="#14213D"/><TextBlock Text="Gestão completa de fornecedores, compras, saldos e desempenho" Foreground="#64748B" Margin="0,4,0,18"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Exportar" Click="Export_Click" Width="100" Height="40"/><Button Content="＋ Novo fornecedor" Click="New_Click" Width="160" Height="40"/></StackPanel></DockPanel><Grid Grid.Row="1" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="150"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" Grid.Column="0" Height="40" VerticalContentAlignment="Center" TextChanged="FilterChanged"/><ComboBox x:Name="StatusBox" Grid.Column="1" Margin="8,0,0,0" Height="40" SelectionChanged="FilterChanged"><ComboBoxItem Content="Todos os estados" IsSelected="True"/><ComboBoxItem Content="Activos"/><ComboBoxItem Content="Inactivos"/></ComboBox><ComboBox x:Name="CountryBox" Grid.Column="2" Margin="8,0,0,0" Height="40"><ComboBoxItem Content="Todos os países" IsSelected="True"/></ComboBox><Button Grid.Column="3" Margin="8,0,0,0" Content="Actualizar" Click="Refresh_Click"/></Grid><Border Grid.Row="2" Background="White" CornerRadius="14" Padding="12"><DataGrid x:Name="GridSuppliers" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="None" RowHeight="58"><DataGrid.Columns><DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="110"/><DataGridTextColumn Header="Fornecedor" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="NUIT" Binding="{Binding TaxId}" Width="150"/><DataGridTextColumn Header="Contacto" Binding="{Binding Phone}" Width="160"/><DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="2*"/><DataGridTextColumn Header="Compras" Binding="{Binding PurchaseCount}" Width="110"/><DataGridTextColumn Header="A pagar" Binding="{Binding Payable}" Width="130"/><DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="100"/><DataGridTemplateColumn Header="Acções" Width="220"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="Editar" Click="Edit_Click" Tag="{Binding}"/><Button Content="Histórico" Click="History_Click" Tag="{Binding}"/><Button Content="⋯" Click="More_Click" Tag="{Binding}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Border><StatusBar Grid.Row="3" Margin="0,12,0,0"><StatusBarItem Content="Fornecedores:"/><StatusBarItem x:Name="CountText"/><Separator/><StatusBarItem Content="A pagar:"/><StatusBarItem x:Name="PayableText"/></StatusBar></Grid></Window>