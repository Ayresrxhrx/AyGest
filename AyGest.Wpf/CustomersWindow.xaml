<Window x:Class="AyGest.Wpf.CustomersWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Clientes — AyGest" Width="1450" Height="900" Background="#F5F7FA" WindowStartupLocation="CenterOwner"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><StackPanel><TextBlock Text="Clientes" FontSize="30" FontWeight="Bold" Foreground="#14213D"/><TextBlock Text="CRM, histórico de compras, crédito, contactos e relacionamento" Foreground="#64748B" Margin="0,4,0,18"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Exportar" Click="Export_Click" Width="100" Height="40"/><Button Content="＋ Novo cliente" Click="New_Click" Width="150" Height="40"/></StackPanel></DockPanel><Grid Grid.Row="1" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="155"/><ColumnDefinition Width="155"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" Grid.Column="0" Height="40" VerticalContentAlignment="Center" TextChanged="FilterChanged"/><ComboBox x:Name="TypeBox" Grid.Column="1" Margin="8,0,0,0" Height="40" SelectionChanged="FilterChanged"><ComboBoxItem Content="Todos os tipos" IsSelected="True"/><ComboBoxItem Content="Particular"/><ComboBoxItem Content="Empresa"/></ComboBox><ComboBox x:Name="StatusBox" Grid.Column="2" Margin="8,0,0,0" Height="40" SelectionChanged="FilterChanged"><ComboBoxItem Content="Todos os estados" IsSelected="True"/><ComboBoxItem Content="Activos"/><ComboBoxItem Content="Inactivos"/></ComboBox><Button Grid.Column="3" Margin="8,0,0,0" Content="Actualizar" Click="Refresh_Click"/></Grid><Border Grid.Row="2" Background="White" CornerRadius="14" Padding="12"><DataGrid x:Name="CustomersGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="None" RowHeight="60"><DataGrid.Columns><DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="105"/><DataGridTextColumn Header="Cliente" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="NUIT" Binding="{Binding TaxId}" Width="145"/><DataGridTextColumn Header="Contacto" Binding="{Binding Phone}" Width="155"/><DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="2*"/><DataGridTextColumn Header="Compras" Binding="{Binding PurchaseCount}" Width="100"/><DataGridTextColumn Header="Total comprado" Binding="{Binding TotalSpent}" Width="130"/><DataGridTextColumn Header="Saldo" Binding="{Binding Balance}" Width="120"/><DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="95"/><DataGridTemplateColumn Header="Acções" Width="230"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="Editar" Click="Edit_Click" Tag="{Binding}"/><Button Content="Histórico" Click="History_Click" Tag="{Binding}"/><Button Content="Conta" Click="Account_Click" Tag="{Binding}"/><Button Content="⋯" Click="More_Click" Tag="{Binding}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Border><StatusBar Grid.Row="3" Margin="0,12,0,0"><StatusBarItem Content="Clientes:"/><StatusBarItem x:Name="CountText"/><Separator/><StatusBarItem Content="Vendas:"/><StatusBarItem x:Name="SalesText"/><Separator/><StatusBarItem Content="Saldos:"/><StatusBarItem x:Name="BalanceText"/></StatusBar></Grid></Window>