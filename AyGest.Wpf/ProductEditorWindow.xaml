<Window x:Class="AyGest.Wpf.ProductEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Produto" Width="800" SizeToContent="Height" WindowStartupLocation="CenterOwner" Background="#F5F7FA"><ScrollViewer><Grid Margin="24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.ColumnSpan="2" Text="Dados do produto" FontSize="25" FontWeight="Bold" Margin="0,0,0,18"/><TextBox x:Name="SkuBox" Grid.Row="1" Margin="4"/><TextBox x:Name="BarcodeBox" Grid.Row="1" Grid.Column="1" Margin="4"/><TextBox x:Name="NameBox" Grid.Row="2" Grid.ColumnSpan="2" Margin="4"/><TextBox x:Name="CategoryBox" Grid.Row="3" Margin="4"/><ComboBox x:Name="UnitBox" Grid.Row="3" Grid.Column="1" Margin="4"><ComboBoxItem Content="UN" IsSelected="True"/><ComboBoxItem Content="KG"/><ComboBoxItem Content="L"/><ComboBoxItem Content="CX"/><ComboBoxItem Content="EMB"/></ComboBox><TextBox x:Name="SalePriceBox" Grid.Row="4" Margin="4"/><TextBox x:Name="CostPriceBox" Grid.Row="4" Grid.Column="1" Margin="4"/><TextBox x:Name="MinStockBox" Grid.Row="5" Margin="4"/><TextBox x:Name="MaxStockBox" Grid.Row="5" Grid.Column="1" Margin="4"/><TextBox x:Name="VatBox" Grid.Row="6" Margin="4"/><TextBox x:Name="LocationBox" Grid.Row="6" Grid.Column="1" Margin="4"/><TextBox x:Name="InitialStockBox" Grid.Row="7" Margin="4"/><TextBox x:Name="SupplierBox" Grid.Row="7" Grid.Column="1" Margin="4"/><TextBox x:Name="BrandBox" Grid.Row="8" Margin="4"/><TextBox x:Name="ModelBox" Grid.Row="8" Grid.Column="1" Margin="4"/><TextBox x:Name="DescriptionBox" Grid.Row="9" Grid.ColumnSpan="2" Margin="4" Height="75" TextWrapping="Wrap"/><CheckBox x:Name="ActiveBox" Grid.Row="10" Content="Produto activo e disponível para venda" IsChecked="True" Margin="4"/><StackPanel Grid.Row="11" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" Click="Cancel_Click" Background="#E2E8F0" Foreground="#14213D"/><Button Content="Guardar produto" Click="Save_Click"/></StackPanel></Grid></ScrollViewer></Window>