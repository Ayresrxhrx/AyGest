<Window x:Class="AyGest.Wpf.ProductEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Produto" Width="900" MinHeight="720" SizeToContent="Height" WindowStartupLocation="CenterOwner" Background="#F6F7F9"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Grid.Row="0" Margin="0,0,0,22"><StackPanel><TextBlock Text="Produto" FontSize="28" FontWeight="SemiBold" Foreground="#172033"/><TextBlock Text="Cadastre o produto, preços, stock e informação comercial" FontSize="13" Foreground="#667085" Margin="0,4,0,0"/></StackPanel><Border DockPanel.Dock="Right" Background="#EEF2FF" CornerRadius="18" Padding="12,7"><TextBlock Text="CATÁLOGO" Foreground="#3157D5" FontWeight="SemiBold"/></Border></DockPanel><Border Grid.Row="1" Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Identificação" Grid.ColumnSpan="2" FontSize="16" FontWeight="SemiBold"/><StackPanel Grid.Row="1" Margin="0,14,8,0"><TextBlock Text="SKU" FontSize="12" Foreground="#667085" Margin="0,0,0,4"/><TextBox x:Name="SkuBox"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="1" Margin="8,14,0,0"><TextBlock Text="Código de barras" FontSize="12" Foreground="#667085" Margin="0,0,0,4"/><TextBox x:Name="BarcodeBox"/></StackPanel><StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,14,0,0"><TextBlock Text="Nome do produto" FontSize="12" Foreground="#667085" Margin="0,0,0,4"/><TextBox x:Name="NameBox"/></StackPanel><StackPanel Grid.Row="3" Margin="0,14,8,0"><TextBlock Text="Categoria" FontSize="12" Foreground="#667085" Margin="0,0,0,4"/><TextBox x:Name="CategoryBox"/></StackPanel><StackPanel Grid.Row="3" Grid.Column="1" Margin="8,14,0,0"><TextBlock Text="Unidade" FontSize="12" Foreground="#667085" Margin="0,0,0,4"/><ComboBox x:Name="UnitBox"><ComboBoxItem Content="UN" IsSelected="True"/><ComboBoxItem Content="KG"/><ComboBoxItem Content="L"/><ComboBoxItem Content="CX"/><ComboBoxItem Content="EMB"/></ComboBox></StackPanel></Grid></Border><Border Grid.Row="2" Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Preços e imposto" Grid.ColumnSpan="2" FontSize="16" FontWeight="SemiBold"/><StackPanel Grid.Row="1" Margin="0,14,8,0"><TextBlock Text="Preço de venda (MT)" FontSize="12" Foreground="#667085" Margin="0,0,0,4"/><TextBox x:Name="SalePriceBox"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="1" Margin="8,14,0,0"><TextBlock Text="Preço de custo (MT)" FontSize="12" Foreground="#667085" Margin="0,0,0,4"/><TextBox x:Name="CostPriceBox"/></StackPanel><StackPanel Grid.Row="2" Margin="0,14,8,0"><TextBlock Text="IVA (%)" FontSize="12" Foreground="#667085" Margin="0,0,0,4"/><TextBox x:Name="VatBox"/></StackPanel><StackPanel Grid.Row="2" Grid.Column="1" Margin="8,14,0,0"><TextBlock Text="Localização" FontSize="12" Foreground="#667085" Margin="0,0,0,4"/><TextBox x:Name="LocationBox"/></StackPanel></Grid></Border><Border Grid.Row="3" Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Controlo de stock" Grid.ColumnSpan="2" FontSize="16" FontWeight="SemiBold"/><StackPanel Grid.Row="1" Margin="0,14,8,0"><TextBlock Text="Stock inicial" FontSize="12" Foreground="#667085" Margin="0,0,0,4"/><TextBox x:Name="InitialStockBox"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="1" Margin="8,14,0,0"><TextBlock Text="Stock mínimo" FontSize="12" Foreground="#667085" Margin="0,0,0,4"/><TextBox x:Name="MinStockBox"/></StackPanel><StackPanel Grid.Row="2" Margin="0,14,8,0"><TextBlock Text="Stock máximo" FontSize="12" Foreground="#667085" Margin="0,0,0,4"/><TextBox x:Name="MaxStockBox"/></StackPanel><StackPanel Grid.Row="2" Grid.Column="1" Margin="8,14,0,0"><TextBlock Text="Fornecedor" FontSize="12" Foreground="#667085" Margin="0,0,0,4"/><TextBox x:Name="SupplierBox"/></StackPanel></Grid></Border><Border Grid.Row="4" Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Informação adicional" Grid.ColumnSpan="2" FontSize="16" FontWeight="SemiBold"/><StackPanel Grid.Row="1" Margin="0,14,8,0"><TextBlock Text="Marca" FontSize="12" Foreground="#667085" Margin="0,0,0,4"/><TextBox x:Name="BrandBox"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="1" Margin="8,14,0,0"><TextBlock Text="Modelo" FontSize="12" Foreground="#667085" Margin="0,0,0,4"/><TextBox x:Name="ModelBox"/></StackPanel><StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,14,0,0"><TextBlock Text="Descrição" FontSize="12" Foreground="#667085" Margin="0,0,0,4"/><TextBox x:Name="DescriptionBox" Height="75" TextWrapping="Wrap" AcceptsReturn="True"/></StackPanel><CheckBox x:Name="ActiveBox" Grid.Row="3" Content="Produto activo e disponível para venda" IsChecked="True" Margin="0,16,0,0"/></Grid></Border><Border Grid.Row="5" Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="12" Padding="14"><DockPanel><TextBlock Text="Os preços e o stock são apresentados em MT." Foreground="#667085" FontSize="12" VerticalAlignment="Center"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Cancelar" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" MinWidth="105"/><Button Content="Guardar produto" Click="Save_Click" Style="{StaticResource SuccessButton}" MinWidth="150" IsDefault="True"/></StackPanel></DockPanel></Border></Grid></ScrollViewer></Window>