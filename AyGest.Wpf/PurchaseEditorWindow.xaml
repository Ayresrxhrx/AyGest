<Window x:Class="AyGest.Wpf.PurchaseEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Nova compra" Width="1200" Height="780" WindowStartupLocation="CenterOwner" Background="#F5F7FA"><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><StackPanel><TextBlock Text="Nova compra" FontSize="28" FontWeight="Bold" Foreground="#14213D"/><TextBlock Text="Registe a compra e os itens recebidos" Foreground="#64748B"/></StackPanel></DockPanel><Grid Grid.Row="1" Margin="0,18,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="320"/><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox x:Name="NumberBox" Grid.Column="0" Margin="4"/><ComboBox x:Name="SupplierBox" Grid.Column="1" Margin="4"/><DatePicker x:Name="DateBox" Grid.Column="2" Margin="4"/><TextBox x:Name="DocumentBox" Grid.Column="3" Margin="4"/></Grid><DataGrid x:Name="ItemsGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="True" Margin="0,0,0,12"><DataGrid.Columns><DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="120"/><DataGridTextColumn Header="Produto" Binding="{Binding Product}" Width="2*"/><DataGridTextColumn Header="Qtd." Binding="{Binding Quantity}" Width="100"/><DataGridTextColumn Header="Custo unitário" Binding="{Binding UnitCost}" Width="130"/><DataGridTextColumn Header="IVA %" Binding="{Binding Vat}" Width="90"/><DataGridTextColumn Header="Desconto" Binding="{Binding Discount}" Width="100"/><DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="130"/></DataGrid.Columns></DataGrid><DockPanel Grid.Row="3"><StackPanel DockPanel.Dock="Right"><TextBlock x:Name="SubtotalText" FontSize="16"/><TextBlock x:Name="VatText" FontSize="16"/><TextBlock x:Name="TotalText" FontSize="25" FontWeight="Bold" Foreground="#14213D"/><StackPanel Orientation="Horizontal"><Button Content="Cancelar" Click="Cancel_Click"/><Button Content="Guardar rascunho" Click="Draft_Click"/><Button Content="Receber e actualizar stock" Click="Receive_Click"/></StackPanel></StackPanel></DockPanel></Grid></Window>