<Window x:Class="AyGest.Wpf.SalesPosWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Vendas / POS — AyGest" Width="1600" Height="950" Background="#F4F6F8" WindowStartupLocation="CenterOwner"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,14"><StackPanel><TextBlock Text="Vendas / POS" FontSize="30" FontWeight="Bold" Foreground="#14213D"/><TextBlock Text="Ponto de venda, pedidos, pagamentos, clientes e facturação" Foreground="#64748B"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock x:Name="CashStatusText" VerticalAlignment="Center" Margin="0,0,14,0"/><Button Content="Nova venda" Click="NewSale_Click" Width="115" Height="40"/><Button Content="Suspensas" Click="Suspended_Click" Width="110" Height="40"/><Button Content="Histórico" Click="History_Click" Width="105" Height="40"/></StackPanel></DockPanel><Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/><ColumnDefinition Width="180"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" Grid.Column="0" Height="42" VerticalContentAlignment="Center" TextChanged="SearchChanged"/><ComboBox x:Name="CategoryBox" Grid.Column="1" Margin="8,0,0,0" Height="42" SelectionChanged="SearchChanged"><ComboBoxItem Content="Todas categorias" IsSelected="True"/></ComboBox><ComboBox x:Name="CustomerBox" Grid.Column="2" Margin="8,0,0,0" Height="42"/><Button Grid.Column="3" Margin="8,0,0,0" Content="Ler código de barras" Click="Barcode_Click" Height="42"/></Grid><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1.35*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="White" CornerRadius="14" Padding="12" Margin="0,0,10,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="ProductsPanel"/></ScrollViewer></Border><Border Grid.Column="1" Background="White" CornerRadius="14" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><StackPanel><TextBlock Text="Carrinho" FontSize="22" FontWeight="Bold"/><TextBlock x:Name="SaleNumberText" Foreground="#64748B"/></StackPanel><Button DockPanel.Dock="Right" Content="Limpar" Click="Clear_Click" Width="80" Height="34"/></DockPanel><DataGrid Grid.Row="1" x:Name="CartGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="None" Margin="0,12"><DataGrid.Columns><DataGridTextColumn Header="Produto" Binding="{Binding Product}" Width="*"/><DataGridTextColumn Header="Qtd." Binding="{Binding Quantity}" Width="65"/><DataGridTextColumn Header="Preço" Binding="{Binding UnitPrice}" Width="90"/><DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="100"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2"><TextBlock x:Name="SubtotalText" FontSize="15"/><TextBlock x:Name="DiscountText" FontSize="15"/><TextBlock x:Name="VatText" FontSize="15"/><TextBlock x:Name="TotalText" FontSize="30" FontWeight="Bold" Foreground="#14213D"/><UniformGrid Columns="3" Margin="0,10"><Button Content="Dinheiro" Click="Cash_Click" Height="48"/><Button Content="M-Pesa" Click="Mpesa_Click" Height="48"/><Button Content="Cartão" Click="Card_Click" Height="48"/></UniformGrid><UniformGrid Columns="2"><Button Content="Suspender venda" Click="Suspend_Click" Height="44"/><Button Content="Finalizar / Emitir factura" Click="Checkout_Click" Height="44"/></UniformGrid></StackPanel></Grid></Border></Grid><StatusBar Grid.Row="3" Margin="0,10,0,0"><StatusBarItem Content="Itens:"/><StatusBarItem x:Name="ItemsText"/><Separator/><StatusBarItem Content="Vendas hoje:"/><StatusBarItem x:Name="SalesTodayText"/><Separator/><StatusBarItem Content="Total hoje:"/><StatusBarItem x:Name="SalesTotalText"/></StatusBar></Grid></Window>