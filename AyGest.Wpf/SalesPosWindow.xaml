<Window x:Class="AyGest.Wpf.SalesPosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AyGest · Ponto de Venda"
        Width="1600" Height="950" MinWidth="1180" MinHeight="720"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="PosIconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="PaymentButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Margin" Value="4,0,4,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="PrimaryCheckoutButton" TargetType="Button" BasedOn="{StaticResource SuccessButton}">
            <Setter Property="Height" Value="56"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style x:Key="PosText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Ponto de Venda" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <Border Background="#EEF2FF" CornerRadius="16" Padding="10,5" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="FACTURAÇÃO" Foreground="{StaticResource PrimaryBrush}" FontSize="10" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Venda rápida, pagamentos e emissão de documentos" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#ECFDF3" CornerRadius="18" Padding="11,7" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CashStatusText" Text="Caixa" Foreground="#087A58" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Button Content="Nova venda" Click="NewSale_Click" Height="40" Width="110"/>
                <Button Content="Suspensas" Click="Suspended_Click" Height="40" Width="100" Style="{StaticResource SecondaryButton}"/>
                <Button Content="Histórico" Click="History_Click" Height="40" Width="95" Style="{StaticResource SecondaryButton}"/>
            </StackPanel>
        </Grid>

        <!-- SEARCH / CONTEXT -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Height="46" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource MutedBrush}" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="SearchBox" BorderThickness="0" Background="Transparent" Margin="0" Padding="4,0" VerticalContentAlignment="Center" FontSize="14" TextChanged="SearchChanged" ToolTip="Pesquisar por nome ou SKU"/>
                    <TextBlock Grid.Column="2" Text="Pesquisa rápida" Foreground="{StaticResource SubtleBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,2,0"/>
                </Grid>
            </Border>
            <ComboBox x:Name="CategoryBox" Grid.Column="1" Margin="10,0,0,0" Height="46" SelectionChanged="SearchChanged">
                <ComboBoxItem Content="Todas categorias" IsSelected="True"/>
            </ComboBox>
            <ComboBox x:Name="CustomerBox" Grid.Column="2" Margin="10,0,0,0" Height="46" ToolTip="Cliente da venda"/>
            <Button Grid.Column="3" Content="Ler código de barras" Click="Barcode_Click" Height="46" Width="150" Margin="10,0,0,0" Style="{StaticResource SecondaryButton}"/>
        </Grid>

        <!-- MAIN POS -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.15*"/>
                <ColumnDefinition Width="390"/>
            </Grid.ColumnDefinitions>

            <!-- PRODUCTS -->
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="2,0,2,12">
                        <StackPanel>
                            <TextBlock Text="Produtos" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="Seleccione um produto para adicionar ao carrinho" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="ProductsPanel"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- CART / CHECKOUT -->
            <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Carrinho" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SaleNumberText" Text="Nova venda" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Limpar" Click="Clear_Click" Width="70" Height="34" HorizontalAlignment="Right" Style="{StaticResource GhostButton}"/>
                    </Grid>

                    <Border Grid.Row="1" Background="#FAFBFC" CornerRadius="10" BorderBrush="#EEF0F3" BorderThickness="1" Padding="4">
                        <DataGrid x:Name="CartGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="None" HeadersVisibility="Column" Margin="0" Background="Transparent" BorderThickness="0" RowHeight="48">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Produto" Binding="{Binding Product}" Width="*"/>
                                <DataGridTextColumn Header="Qtd." Binding="{Binding Quantity}" Width="52"/>
                                <DataGridTextColumn Header="Preço" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="76"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat={}{0:N2}}" Width="82"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <Grid Margin="0,2">
                            <TextBlock Text="Subtotal" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="SubtotalText" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Desconto" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="DiscountText" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,4,0,8">
                            <TextBlock Text="IVA" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="VatText" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Background="#F3F6FF" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                            <Grid>
                                <TextBlock Text="TOTAL A PAGAR" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TotalText" HorizontalAlignment="Right" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="Método de pagamento" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="4,0,0,7"/>
                        <UniformGrid Columns="3" Margin="0,0,0,2">
                            <Button Content="Dinheiro" Click="Cash_Click" Style="{StaticResource PaymentButton}"/>
                            <Button Content="M-Pesa" Click="Mpesa_Click" Style="{StaticResource PaymentButton}"/>
                            <Button Content="Cartão" Click="Card_Click" Style="{StaticResource PaymentButton}"/>
                        </UniformGrid>
                        <Grid Margin="0,0,0,2">
                            <Button Content="Suspender venda" Click="Suspend_Click" Height="50" Width="145" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}"/>
                            <Button Content="Finalizar · Emitir factura" Click="Checkout_Click" Height="50" Margin="155,0,0,0" Style="{StaticResource PrimaryCheckoutButton}"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,12,0,0" Padding="12,7">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Itens" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock x:Name="ItemsText" FontWeight="SemiBold" Margin="6,0,18,0"/>
                <Separator Width="1" Height="18" Margin="0,0,18,0"/>
                <TextBlock Text="Vendas hoje" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock x:Name="SalesTodayText" FontWeight="SemiBold" Margin="6,0,18,0"/>
                <Separator Width="1" Height="18" Margin="0,0,18,0"/>
                <TextBlock Text="Total hoje" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock x:Name="SalesTotalText" FontWeight="SemiBold" Margin="6,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>