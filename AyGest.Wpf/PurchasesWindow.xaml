<Window x:Class="AyGest.Wpf.PurchasesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Compras — AyGest" Width="1550" Height="930" Background="#F5F7FA" WindowStartupLocation="CenterOwner"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><StackPanel><TextBlock Text="Compras" FontSize="30" FontWeight="Bold" Foreground="#14213D"/><TextBlock Text="Compras, recepção de mercadoria, fornecedores, custos e contas a pagar" Foreground="#64748B" Margin="0,4,0,18"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Exportar" Click="Export_Click" Width="100" Height="40"/><Button Content="＋ Nova compra" Click="New_Click" Width="150" Height="40"/></StackPanel></DockPanel><Grid Grid.Row="1" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="160"/><ColumnDefinition Width="160"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" Grid.Column="0" Height="40" VerticalContentAlignment="Center" TextChanged="FilterChanged"/><ComboBox x:Name="StatusBox" Grid.Column="1" Margin="8,0,0,0" Height="40" SelectionChanged="FilterChanged"><ComboBoxItem Content="Todos os estados" IsSelected="True"/><ComboBoxItem Content="Rascunho"/><ComboBoxItem Content="Recebida"/><ComboBoxItem Content="Paga"/><ComboBoxItem Content="Cancelada"/></ComboBox><DatePicker x:Name="FromDate" Grid.Column="2" Margin="8,0,0,0" SelectedDateChanged="FilterChanged"/><DatePicker x:Name="ToDate" Grid.Column="3" Margin="8,0,0,0" SelectedDateChanged="FilterChanged"/><Button Grid.Column="4" Margin="8,0,0,0" Content="Actualizar" Click="Refresh_Click"/></Grid><Border Grid.Row="2" Background="White" CornerRadius="14" Padding="12"><DataGrid x:Name="PurchasesGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="None" RowHeight="62"><DataGrid.Columns><DataGridTextColumn Header="Nº Compra" Binding="{Binding Number}" Width="120"/><DataGridTextColumn Header="Data" Binding="{Binding Date}" Width="110"/><DataGridTextColumn Header="Fornecedor" Binding="{Binding Supplier}" Width="2*"/><DataGridTextColumn Header="Documento" Binding="{Binding SupplierDocument}" Width="145"/><DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal}" Width="120"/><DataGridTextColumn Header="IVA" Binding="{Binding Vat}" Width="110"/><DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="125"/><DataGridTextColumn Header="Recebido" Binding="{Binding Received}" Width="100"/><DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="105"/><DataGridTemplateColumn Header="Acções" Width="220"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="Abrir" Click="Open_Click" Tag="{Binding}"/><Button Content="Receber" Click="Receive_Click" Tag="{Binding}"/><Button Content="Pagar" Click="Pay_Click" Tag="{Binding}"/><Button Content="⋯" Click="More_Click" Tag="{Binding}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Border><StatusBar Grid.Row="3" Margin="0,12,0,0"><StatusBarItem Content="Compras:"/><StatusBarItem x:Name="CountText"/><Separator/><StatusBarItem Content="Total:"/><StatusBarItem x:Name="TotalText"/><Separator/><StatusBarItem Content="Por pagar:"/><StatusBarItem x:Name="PayableText"/><Separator/><StatusBarItem Content="Recebidas:"/><StatusBarItem x:Name="ReceivedText"/></StatusBar></Grid></Window>