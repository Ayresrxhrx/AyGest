<Window x:Class="AyGest.Wpf.UserEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Utilizador" Width="520" SizeToContent="Height" WindowStartupLocation="CenterOwner" Background="#F5F7FA"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Dados do utilizador" FontSize="24" FontWeight="Bold" Margin="0,0,0,18"/><TextBox x:Name="UsernameBox" Grid.Row="1" Margin="0,4"/><TextBox x:Name="NameBox" Grid.Row="2" Margin="0,4"/><TextBox x:Name="EmailBox" Grid.Row="3" Margin="0,4"/><ComboBox x:Name="RoleBox" Grid.Row="4" Margin="0,4"><ComboBoxItem Content="Administrador"/><ComboBoxItem Content="Gestor"/><ComboBoxItem Content="Caixa"/><ComboBoxItem Content="Vendedor"/><ComboBoxItem Content="Consulta"/></ComboBox><ComboBox x:Name="StatusBox" Grid.Row="5" Margin="0,4"><ComboBoxItem Content="Activo"/><ComboBoxItem Content="Inactivo"/></ComboBox><PasswordBox x:Name="PasswordBox" Grid.Row="6" Margin="0,4"/><StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="Cancelar" Click="Cancel_Click" Background="#E2E8F0" Foreground="#14213D"/><Button Content="Guardar" Click="Save_Click"/></StackPanel></Grid></Window>