<Window x:Class="AyGest.Wpf.UserEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Utilizador" Width="650" SizeToContent="Height" WindowStartupLocation="CenterOwner" Background="#F6F7F9"><Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,22"><StackPanel><TextBlock Text="Utilizador" FontSize="28" FontWeight="SemiBold" Foreground="#172033"/><TextBlock Text="Configure identidade, permissões, estado e acesso ao sistema" FontSize="13" Foreground="#667085" Margin="0,4,0,0"/></StackPanel><Border DockPanel.Dock="Right" Background="#EEF2FF" CornerRadius="18" Padding="12,7"><TextBlock Text="ACESSO" Foreground="#3157D5" FontWeight="SemiBold"/></Border></DockPanel><Border Grid.Row="1" Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Conta" Grid.ColumnSpan="2" FontSize="16" FontWeight="SemiBold"/><StackPanel Grid.Row="1" Margin="0,14,8,0"><TextBlock Text="Nome de utilizador" FontSize="12" Foreground="#667085" Margin="0,0,0,4"/><TextBox x:Name="UsernameBox"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="1" Margin="8,14,0,0"><TextBlock Text="Nome completo" FontSize="12" Foreground="#667085" Margin="0,0,0,4"/><TextBox x:Name="NameBox"/></StackPanel><StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,14,0,0"><TextBlock Text="E-mail" FontSize="12" Foreground="#667085" Margin="0,0,0,4"/><TextBox x:Name="EmailBox"/></StackPanel></Grid></Border><Border Grid.Row="2" Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Permissões e segurança" Grid.ColumnSpan="2" FontSize="16" FontWeight="SemiBold"/><StackPanel Grid.Row="1" Margin="0,14,8,0"><TextBlock Text="Perfil" FontSize="12" Foreground="#667085" Margin="0,0,0,4"/><ComboBox x:Name="RoleBox"><ComboBoxItem Content="Administrador"/><ComboBoxItem Content="Gestor"/><ComboBoxItem Content="Caixa"/><ComboBoxItem Content="Vendedor"/><ComboBoxItem Content="Consulta"/></ComboBox></StackPanel><StackPanel Grid.Row="1" Grid.Column="1" Margin="8,14,0,0"><TextBlock Text="Estado" FontSize="12" Foreground="#667085" Margin="0,0,0,4"/><ComboBox x:Name="StatusBox"><ComboBoxItem Content="Activo"/><ComboBoxItem Content="Inactivo"/></ComboBox></StackPanel></Grid></Border><Border Grid.Row="3" Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="12" Padding="14"><DockPanel><StackPanel><TextBlock Text="Palavra-passe" FontWeight="SemiBold"/><TextBlock Text="Ao editar, deixe em branco para manter a actual." FontSize="11" Foreground="#667085" Margin="0,3,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><PasswordBox x:Name="PasswordBox" Width="190" Margin="4"/><Button Content="Cancelar" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" MinWidth="105"/><Button Content="Guardar" Click="Save_Click" Style="{StaticResource SuccessButton}" MinWidth="130" IsDefault="True"/></StackPanel></DockPanel></Border></Grid></Window>