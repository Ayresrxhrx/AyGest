<Window x:Class="AyGest.Wpf.UsersWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Utilizadores — AyGest" Width="1450" Height="860" MinWidth="1050" MinHeight="680" WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}"><Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Grid.Row="0" Margin="0,0,0,20"><StackPanel><TextBlock Text="Utilizadores" Style="{StaticResource PageTitle}" FontSize="28"/><TextBlock Text="Contas, perfis, permissões, segurança e actividade da equipa" Style="{StaticResource Caption}" FontSize="13" Margin="0,5,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource SecondaryButton}" Content="Actualizar" Click="Refresh_Click" Width="105"/><Button Content="＋ Novo utilizador" Click="New_Click" Width="155"/></StackPanel></DockPanel><UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,18"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="TOTAL DE CONTAS" Style="{StaticResource Caption}"/><TextBlock x:Name="TotalUsersText" Text="—" Style="{StaticResource MetricValue}"/><TextBlock Text="Utilizadores registados" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ACTIVOS" Style="{StaticResource Caption}"/><TextBlock x:Name="ActiveUsersText" Text="—" Style="{StaticResource MetricValue}" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="Com acesso ao sistema" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ADMINISTRADORES" Style="{StaticResource Caption}"/><TextBlock x:Name="AdminUsersText" Text="—" Style="{StaticResource MetricValue}"/><TextBlock Text="Contas com privilégios elevados" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ACESSO RECENTE" Style="{StaticResource Caption}"/><TextBlock x:Name="RecentUsersText" Text="—" Style="{StaticResource MetricValue}"/><TextBlock Text="Últimos acessos registados" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel></Border></UniformGrid><Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="175"/><ColumnDefinition Width="165"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10,0" Margin="0,0,8,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="⌕" Foreground="{StaticResource MutedBrush}" FontSize="18" VerticalAlignment="Center"/><TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent" Padding="4,9" ToolTip="Pesquisar por nome, utilizador ou e-mail" TextChanged="Search_Changed"/></Grid></Border><ComboBox x:Name="RoleFilter" Grid.Column="1" Margin="8,0,0,0" SelectionChanged="Filter_Changed"><ComboBoxItem Content="Todos os perfis" IsSelected="True"/><ComboBoxItem Content="Administrador"/><ComboBoxItem Content="Gestor"/><ComboBoxItem Content="Caixa"/><ComboBoxItem Content="Vendedor"/><ComboBoxItem Content="Consulta"/></ComboBox><ComboBox x:Name="StatusFilter" Grid.Column="2" Margin="8,0,0,0" SelectionChanged="Filter_Changed"><ComboBoxItem Content="Todos os estados" IsSelected="True"/><ComboBoxItem Content="Activos"/><ComboBoxItem Content="Inactivos"/></ComboBox><Button Grid.Column="3" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Content="Limpar filtros" Click="Refresh_Click"/></Grid></Border><Border Grid.Row="3" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Grid.Row="0" Margin="4,2,4,10"><StackPanel Orientation="Horizontal"><TextBlock Text="Contas" Style="{StaticResource SectionTitle}"/><Border Style="{StaticResource StatusSuccess}" Margin="10,0,0,0" Padding="8,4"><TextBlock Text="Gestão de acesso" Foreground="#087A58" FontSize="11" FontWeight="SemiBold"/></Border></StackPanel><TextBlock DockPanel.Dock="Right" Text="Seleccione uma linha para editar ou gerir segurança" Style="{StaticResource Caption}" VerticalAlignment="Center"/></DockPanel><DataGrid x:Name="UsersGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="58"><DataGrid.Columns><DataGridTextColumn Header="UTILIZADOR" Binding="{Binding Username}" Width="1.25*"/><DataGridTextColumn Header="NOME COMPLETO" Binding="{Binding FullName}" Width="1.8*"/><DataGridTextColumn Header="PERFIL" Binding="{Binding Role}" Width="1.1*"/><DataGridTextColumn Header="E-MAIL" Binding="{Binding Email}" Width="1.8*"/><DataGridTextColumn Header="ESTADO" Binding="{Binding Status}" Width="1*"/><DataGridTextColumn Header="ÚLTIMO ACESSO" Binding="{Binding LastLogin}" Width="1.5*"/><DataGridTemplateColumn Header="ACÇÕES" Width="225"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Style="{StaticResource SecondaryButton}" Content="Editar" Click="Edit_Click" Tag="{Binding}"/><Button Style="{StaticResource SecondaryButton}" Content="Segurança" Click="Security_Click" Tag="{Binding}"/><Button Style="{StaticResource GhostButton}" Content="⋯" Click="More_Click" Tag="{Binding}"