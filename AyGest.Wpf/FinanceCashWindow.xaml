<Window x:Class="AyGest.Wpf.FinanceCashWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Financeiro e Caixa — AyGest" Width="1550" Height="930" Background="#F5F7FA" WindowStartupLocation="CenterOwner"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><StackPanel><TextBlock Text="Financeiro e Caixa" FontSize="30" FontWeight="Bold" Foreground="#14213D"/><TextBlock Text="Tesouraria, movimentos, caixa, pagamentos, recebimentos e controlo financeiro" Foreground="#64748B" Margin="0,4,0,18"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Abrir caixa" Click="OpenCash_Click" Width="120" Height="40"/><Button Content="Fechar caixa" Click="CloseCash_Click" Width="120" Height="40"/><Button Content="＋ Movimento" Click="Movement_Click" Width="135" Height="40"/><Button Content="Exportar" Click="Export_Click" Width="100" Height="40"/></StackPanel></DockPanel><UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,16"><Border Background="White" CornerRadius="12" Margin="4" Padding="18"><StackPanel><TextBlock Text="Saldo actual" Foreground="#64748B"/><TextBlock x:Name="BalanceText" FontSize="24" FontWeight="Bold" Text="0,00 MT"/></StackPanel></Border><Border Background="White" CornerRadius="12" Margin="4" Padding="18"><StackPanel><TextBlock Text="Recebimentos hoje" Foreground="#64748B"/><TextBlock x:Name="InText" FontSize="24" FontWeight="Bold" Text="0,00 MT"/></StackPanel></Border><Border Background="White" CornerRadius="12" Margin="4" Padding="18"><StackPanel><TextBlock Text="Pagamentos hoje" Foreground="#64748B"/><TextBlock x:Name="OutText" FontSize="24" FontWeight="Bold" Text="0,00 MT"/></StackPanel></Border><Border Background="White" CornerRadius="12" Margin="4" Padding="18"><StackPanel><TextBlock Text="A receber" Foreground="#64748B"/><TextBlock x:Name="ReceivableText" FontSize="24" FontWeight="Bold" Text="0,00 MT"/></StackPanel></Border><Border Background="White" CornerRadius="12" Margin="4" Padding="18"><StackPanel><TextBlock Text="A pagar" Foreground="#64748B"/><TextBlock x:Name="PayableText" FontSize="24" FontWeight="Bold" Text="0,00 MT"/></StackPanel></Border></UniformGrid><Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Grid.Row="0" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" Grid.Column="0" Height="40" TextChanged="FilterChanged"/><ComboBox x:Name="TypeBox" Grid.Column="1" Margin="8,0,0,0" Height="40" SelectionChanged="FilterChanged"><ComboBoxItem Content="Todos os tipos" IsSelected="True"/><ComboBoxItem Content="Recebimento"/><ComboBoxItem Content="Pagamento"/><ComboBoxItem Content="Transferência"/><ComboBoxItem Content="Ajuste"/></ComboBox><DatePicker x:Name="FromDate" Grid.Column="2" Margin="8,0,0,0" SelectedDateChanged="FilterChanged"/><DatePicker x:Name="ToDate" Grid.Column="3" Margin="8,0,0,0" SelectedDateChanged="FilterChanged"/><Button Grid.Column="4" Margin="8,0,0,0" Content="Actualizar" Click="Refresh_Click"/></Grid><Border Grid.Row="1" Background="White" CornerRadius="14" Padding="12"><DataGrid x:Name="MovementsGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="None" RowHeight="58"><DataGrid.Columns><DataGridTextColumn Header="Data" Binding="{Binding Date}" Width="130"/><DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="125"/><DataGridTextColumn Header="Descrição" Binding="{Binding Description}" Width="2*"/><DataGridTextColumn Header="Documento" Binding="{Binding Reference}" Width="145"/><DataGridTextColumn Header="Método" Binding="{Binding Method}" Width="130"/><DataGridTextColumn Header="Entrada" Binding="{Binding Inflow}" Width="125"/><DataGridTextColumn Header="Saída" Binding="{Binding Outflow}" Width="125"/><DataGridTextColumn Header="Saldo" Binding="{Binding Balance}" Width="130"/></DataGrid.Columns></DataGrid></Border></Grid><StatusBar Grid.Row="3" Margin="0,12,0,0"><StatusBarItem Content="Movimentos:"/><StatusBarItem x:Name="CountText"/><Separator/><StatusBarItem Content="Entradas:"/><StatusBarItem x:Name="TotalInText"/><Separator/><StatusBarItem Content="Saídas:"/><StatusBarItem x:Name="TotalOutText"/></StatusBar></Grid></Window>