<Window x:Class="AyGest.Wpf.CustomerEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Cliente" Width="820" MinHeight="650" SizeToContent="Height" WindowStartupLocation="CenterOwner" Background="#F6F7F9"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Grid.Row="0" Margin="0,0,0,22"><StackPanel><TextBlock Text="Cliente" FontSize="28" FontWeight="SemiBold" Foreground="#172033"/><TextBlock Text="Registe ou actualize os dados do cliente" FontSize="13" Foreground="#667085" Margin="0,4,0,0"/></StackPanel><Border DockPanel.Dock="Right" Background="#ECFDF3" CornerRadius="18" Padding="12,7" VerticalAlignment="Top"><TextBlock Text="● Registo" Foreground="#087443" FontWeight="SemiBold"/></Border></DockPanel><Border Grid.Row="1" Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><StackPanel><TextBlock Text="Identificação" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Código interno" FontSize="12" Foreground="#667085" Margin="0,12,0,4"/><TextBox x:Name="CodeBox"/></StackPanel><StackPanel Grid.Column="1" Margin="16,0,0,0"><TextBlock Text="Tipo" FontSize="12" Foreground="#667085" Margin="0,28,0,4"/><ComboBox x:Name="TypeBox"><ComboBoxItem Content="Particular" IsSelected="True"/><ComboBoxItem Content="Empresa"/></ComboBox></StackPanel><StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0"><TextBlock Text="Nome / Razão social" FontSize="12" Foreground="#667085" Margin="0,0,0,4"/><TextBox x:Name="NameBox"/></StackPanel></Grid></Border><Border Grid.Row="2" Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Contactos e identificação fiscal" Grid.ColumnSpan="2" FontSize="16" FontWeight="SemiBold"/><StackPanel Grid.Row="1" Margin="0,14,8,0"><TextBlock Text="NUIT" FontSize="12" Foreground="#667085" Margin="0,0,0,4"/><TextBox x:Name="TaxIdBox"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="1" Margin="8,14,0,0"><TextBlock Text="Telefone" FontSize="12" Foreground="#667085" Margin="0,0,0,4"/><TextBox x:Name="PhoneBox"/></StackPanel><StackPanel Grid.Row="2" Margin="12,14,8,0"><TextBlock Text="E-mail" FontSize="12" Foreground="#667085" Margin="0,0,0,4"/><TextBox x:Name="EmailBox"/></StackPanel><StackPanel Grid.Row="2" Grid.Column="1" Margin="8,14,0,0"><TextBlock Text="Website" FontSize="12" Foreground="#667085" Margin="0,0,0,4"/><TextBox x:Name="WebsiteBox"/></StackPanel></Grid></Border><Border Grid.Row="3" Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Morada" Grid.ColumnSpan="2" FontSize="16" FontWeight="SemiBold"/><StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0"><TextBlock Text="Endereço" FontSize="12" Foreground="#667085" Margin="0,0,0,4"/><TextBox x:Name="AddressBox" Height="58" TextWrapping="Wrap" AcceptsReturn="True"/></StackPanel><StackPanel Grid.Row="2" Margin="0,14,8,0"><TextBlock Text="Cidade" FontSize="12" Foreground="#667085" Margin="0,0,0,4"/><TextBox x:Name="CityBox"/></StackPanel><StackPanel Grid.Row="2" Grid.Column="1" Margin="8,14,0,0"><TextBlock Text="Pessoa de contacto" FontSize="12" Foreground="#667085" Margin="0,0,0,4"/><TextBox x:Name="ContactBox"/></StackPanel></Grid></Border><Border Grid.Row="4" Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Condições comerciais" Grid.ColumnSpan="2" FontSize="16" FontWeight="SemiBold"/><StackPanel Grid.Row="1" Margin="0,14,8,0"><TextBlock Text="Limite de crédito (MT)" FontSize="12" Foreground="#667085" Margin="0,0,0,4"/><TextBox x:Name="CreditLimitBox"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="1" Margin="8,14,0,0"><TextBlock Text="Condições de pagamento" FontSize="12" Foreground="#667085" Margin="0,0,0,4"/><TextBox x:Name="PaymentTermsBox"/></StackPanel><StackPanel Grid.Row="2" Margin="0,14,8,0"><TextBlock Text="Estado" FontSize="12" Foreground="#667085" Margin="0,0,0,4"/><ComboBox x:Name="StatusBox"><ComboBoxItem Content="Activo" IsSelected="True"/><ComboBoxItem Content="Inactivo"/></ComboBox></StackPanel></Grid></Border><Border Grid.Row="5" Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,18"><StackPanel><TextBlock Text="Notas" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Informação interna sobre este cliente" FontSize="12" Foreground="#667085" Margin="0,3,0,8"/><TextBox x:Name="NotesBox" Height="75" TextWrapping="Wrap" AcceptsReturn="True"/></StackPanel></Border><Border Grid.Row="6" Background="#FFFFFF" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="12" Padding="14"><DockPanel><TextBlock Text="Os campos marcados são usados na facturação e documentos." Foreground="#667085" FontSize="12" VerticalAlignment="Center"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Cancelar" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" MinWidth="105"/><Button Content="Guardar cliente" Click="Save_Click" Style="{StaticResource SuccessButton}" MinWidth="150" IsDefault="True"/></StackPanel></DockPanel></Border></Grid></ScrollViewer></Window>