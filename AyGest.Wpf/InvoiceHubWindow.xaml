<Window x:Class="AyGest.Wpf.InvoiceHubWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Centro de Facturação — AyGest" Width="1180" Height="760" MinWidth="980" MinHeight="640" WindowStartupLocation="CenterOwner" Background="#F6F8FB">
<Grid Margin="28">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="Facturação" FontSize="30" FontWeight="SemiBold" Foreground="#172033"/><TextBlock Text="Centro de operações para documentos, vendas e recebimentos" Margin="0,5,0,0" FontSize="13" Foreground="#6B7280"/></StackPanel>
<UniformGrid Grid.Row="1" Columns="4" Margin="0,22,0,22">
<Border Margin="0,0,10,0" Background="White" CornerRadius="14" Padding="18" BorderBrush="#E6EAF0" BorderThickness="1"><StackPanel><TextBlock Text="VENDAS HOJE" FontSize="11" Foreground="#7A8496"/><TextBlock x:Name="SalesToday" Text="0,00 MT" FontSize="23" FontWeight="SemiBold" Margin="0,6,0,0" Foreground="#172033"/><TextBlock x:Name="SalesCount" Text="0 documentos" FontSize="11" Foreground="#8A94A6" Margin="0,3,0,0"/></StackPanel></Border>
<Border Margin="0,0,10,0" Background="White" CornerRadius="14" Padding="18" BorderBrush="#E6EAF0" BorderThickness="1"><StackPanel><TextBlock Text="PENDENTES" FontSize="11" Foreground="#7A8496"/><TextBlock x:Name="PendingCount" Text="0" FontSize="23" FontWeight="SemiBold" Margin="0,6,0,0" Foreground="#172033"/><TextBlock Text="Documentos por concluir" FontSize="11" Foreground="#8A94A6" Margin="0,3,0,0"/></StackPanel></Border>
<Border Margin="0,0,10,0" Background="White" CornerRadius="14" Padding="18" BorderBrush="#E6EAF0" BorderThickness="1"><StackPanel><TextBlock Text="ANULADAS" FontSize="11" Foreground="#7A8496"/><TextBlock x:Name="CancelledCount" Text="0" FontSize="23" FontWeight="SemiBold" Margin="0,6,0,0" Foreground="#172033"/><TextBlock Text="No período actual" FontSize="11" Foreground="#8A94A6" Margin="0,3,0,0"/></StackPanel></Border>
<Border Background="#172033" CornerRadius="14" Padding="18"><StackPanel><TextBlock Text="ACÇÕES RÁPIDAS" FontSize="11" Foreground="#AAB4C5"/><Button Content="Nova factura" Click="NewInvoice_Click" Margin="0,10,0,0" Padding="12,9" Background="#3157D5" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/><Button Content="Abrir POS" Click="OpenPos_Click" Margin="0,7,0,0" Padding="12,9" Background="#243149" Foreground="White" BorderThickness="0"/></StackPanel></Border>
</UniformGrid>
<ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="Fluxo de facturação" FontSize="18" FontWeight="SemiBold" Foreground="#172033" Margin="0,0,0,12"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="36"/><ColumnDefinition/><ColumnDefinition Width="36"/><ColumnDefinition/><ColumnDefinition Width="36"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Button Grid.Column="0" Click="NewInvoice_Click" Style="{StaticResource MapCardStyle}"><StackPanel><TextBlock Text="01" Style="{StaticResource MapNumberStyle}"/><TextBlock Text="Nova venda" Style="{StaticResource MapTitleStyle}"/><TextBlock Text="Criar factura a partir do POS e seleccionar cliente, produtos e pagamento." Style="{StaticResource MapTextStyle}"/></StackPanel></Button><TextBlock Grid.Column="1" Text="→" Style="{StaticResource ArrowStyle}"/>
<Button Grid.Column="2" Click="OpenInvoices_Click" Style="{StaticResource MapCardStyle}"><StackPanel><TextBlock Text="02" Style="{StaticResource MapNumberStyle}"/><TextBlock Text="Facturas" Style="{StaticResource MapTitleStyle}"/><TextBlock Text="Pesquisar, filtrar, consultar estado, abrir documento e acompanhar histórico." Style="{StaticResource MapTextStyle}"/></StackPanel></Button><TextBlock Grid.Column="3" Text="→" Style="{StaticResource ArrowStyle}"/>
<Button Grid.Column="4" Click="OpenCash_Click" Style="{StaticResource MapCardStyle}"><StackPanel><TextBlock Text="03" Style="{StaticResource MapNumberStyle}"/><TextBlock Text="Recebimento" Style="{StaticResource MapTitleStyle}"/><TextBlock Text="Métodos de pagamento, caixa, movimentos e reconciliação." Style="{StaticResource MapTextStyle}"/></StackPanel></Button><TextBlock Grid.Column="5" Text="→" Style="{StaticResource ArrowStyle}"/>
<Button Grid.Column="6" Click="OpenReports_Click" Style="{StaticResource MapCardStyle}"><StackPanel><TextBlock Text="04" Style="{StaticResource MapNumberStyle}"/><TextBlock Text="Relatórios" Style="{StaticResource MapTitleStyle}"/><TextBlock Text="Vendas, IVA, pagamentos, documentos e desempenho comercial." Style="{StaticResource MapTextStyle}"/></StackPanel></Button>
</Grid>
<TextBlock Text="Gestão documental" FontSize="18" FontWeight="SemiBold" Foreground="#172033" Margin="0,28,0,12"/>
<UniformGrid Columns="3">
<Button Content="Consultar facturas" Click="OpenInvoices_Click" Style="{StaticResource ActionCardStyle}"/><Button Content="Anulações e reversões" Click="OpenInvoices_Click" Style="{StaticResource ActionCardStyle}"/><Button Content="Exportar / imprimir PDF" Click="OpenInvoices_Click" Style="{StaticResource ActionCardStyle}"/><Button Content="Métodos de pagamento" Click="OpenSettings_Click" Style="{StaticResource ActionCardStyle}"/><Button Content="Séries e numeração" Click="OpenSettings_Click" Style="{StaticResource ActionCardStyle}"/><Button Content="Clientes" Click="OpenCustomers_Click" Style="{StaticResource ActionCardStyle}"/>
</UniformGrid>
</StackPanel></ScrollViewer>
</Grid></Window>